# FlashApp Engine — Backend
APP_NAME=FlashApp Engine
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=flashapp

# JWT (task #2 will use these)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Redis / Celery (task #6)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 开发冒烟可设 true：任务在调用进程内同步执行，无需 Redis Worker
CELERY_TASK_ALWAYS_EAGER=false

# Local model endpoints (see docs/local_models.md)
QWEN_BASE_URL=http://10.8.136.35:8081
SEEDCODER_BASE_URL=http://10.8.136.35:8881
EMBEDDING_BASE_URL=http://10.8.136.35:8002
RERANKER_BASE_URL=http://10.8.136.35:8003
DEEPSEEK_BASE_URL=http://10.32.129.214:8000
FUNASR_WS_URL=ws://10.17.150.235:10095
MODEL_STATUS_URL=http://10.17.150.235:30001/api/status

# Sandbox
SANDBOX_PORT_MIN=30000
SANDBOX_PORT_MAX=40000
GENERATED_CODE_ROOT=/tmp/flashapp/tasks
