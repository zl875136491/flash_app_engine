# FlashApp Frontend env example

# 推荐留空：语音走同源 wss://<当前主机>/api/v1/asr/ws（由后端转发 FunASR）
# 仅在直连 FunASR 且页面为 HTTP/localhost 时才填写：
# VITE_FUNASR_WS_URL=ws://10.17.150.235:10095
VITE_FUNASR_WS_URL=

# 开发 HTTPS（默认 true；需先生成 ../certs/ip.*）
VITE_HTTPS=true
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# Vite 将 /api 反代到此后端（浏览器侧仍是同源 /api，无混合内容）
# 后端若也开了 HTTPS，可改为 https://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
